  "scoringProfiles": [
    {
      "name": "freshness-boost",
      "text": {
        "weights": {
          "title": 3,
          "content": 2,
          "summary": 1.5
        }
      },
      "functions": [
        {
          "type": "freshness",
          "fieldName": "modified_date",
          "boost": 2,
          "interpolation": "linear",
          "freshness": {
            "boostingDuration": "P30D"
          }
        }
      ]
    },
    {
      "name": "relevance-boost",
      "text": {
        "weights": {
          "title": 5,
          "content": 3,
          "summary": 2,
          "key_phrases": 1.5,
          "tags": 1.5
        }
      },
      "functions": [
        {
          "type": "magnitude",
          "fieldName": "file_size",
          "boost": 0.5,
          "interpolation": "logarithmic",
          "magnitude": {
            "boostingRangeStart": 1000,
            "boostingRangeEnd": 10000000
          }
        }
      ]
    }
  ],
  "vectorSearch": {
